# --- SoftGlaze Licensing Server — environment ---
# Copy to .env and fill in. NEVER commit .env.

# MySQL connection string (Prisma datasource). Production runs on MySQL (the
# Hostinger deploy has no Postgres), so the schema's provider is `mysql`.
DATABASE_URL="mysql://user:pass@localhost:3306/softglaze_licensing"

# 32-byte base64 master key. Encrypts tenant payment secrets AND tenant private
# keys at rest (AES-256-GCM). Losing/rotating this invalidates all sealed values.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=""

# HTTP
PORT=8787
# The public origin the desktop apps + payment webhooks reach this server at.
PUBLIC_BASE_URL="http://localhost:8787"

# License lease lifetime in days. The desktop app refreshes within this window
# while online; offline it runs on the cached lease until it expires, then nags.
LEASE_DAYS=7

# Outgoing email (verification codes, trial emails). On the live server these are written into
# config/.env by the owner's `run.sh set-smtp` (hidden prompt) and re-read without a restart.
# Leave them empty on test machines: nothing is sent and verify/start answers 503 email_unavailable.
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Proxies in front of the app (Express "trust proxy" hop count; re-read without a restart).
# 1 = the rightmost X-Forwarded-For entry. Measure it with `run.sh check-ip`.
TRUST_PROXY_HOPS=1

# Optional: domains accepted at sign-up even though they are on the disposable list (comma list).
EMAIL_DOMAIN_ALLOWLIST=""

# Optional: per-IP limits per minute (public endpoints / verification + trial endpoints).
# PUBLIC_RATE_PER_MIN=120
# VERIFY_RATE_PER_MIN=20
# Website checkouts (POST /v1/checkout without an install) per IP per minute.
# WEB_CHECKOUT_RATE_PER_MIN=10
# The website that sells without the app: Safepay returns buyers to <SITE_BASE_URL>/buy/thanks, and its
# origin (plus http://localhost) may call /v1/checkout and /v1/checkout/status from the browser.
# SITE_BASE_URL=https://browser.softglaze.com

# One-click sign-in (app 1.0.26): "Continue with GitHub". From the GitHub OAuth App the owner creates
# (callback URL = PUBLIC_BASE_URL + /auth/callback/github). Typed into config/.env by the owner on the server,
# re-read without a restart. Never commit them. Without both, the app hides the GitHub button
# (GET /auth/providers) and "Continue with email" still works.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Optional: the X-GitHub-Api-Version header (default 2026-03-10) and the per-IP limit for /auth/* per minute.
# GITHUB_API_VERSION=2026-03-10
# AUTH_RATE_PER_MIN=30

# "Continue with Google" (desktop, phone and web; docs/GOOGLE-SIGNIN.md). ONE Google OAuth client of type
# "Web application" with the redirect URI PUBLIC_BASE_URL + /auth/callback/google. Typed into config/.env by the
# owner on the server, re-read without a restart. Never commit them. Without both, no app shows the Google button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# "Continue with Facebook" (desktop, phone and web; docs/FACEBOOK-SIGNIN.md). ONE Meta app with Facebook Login,
# Valid OAuth Redirect URI PUBLIC_BASE_URL + /auth/callback/facebook (strict mode), permissions email +
# public_profile, and the Data Deletion callback URL PUBLIC_BASE_URL + /auth/facebook/data-deletion. Typed into
# config/.env by the owner on the server, re-read without a restart. Never commit them. Without both, no app shows
# the Facebook button and the deletion callback answers 503.
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
# Optional: the Graph API version for the dialog and Graph calls (default v27.0).
# FACEBOOK_GRAPH_VERSION=v27.0

# "Continue with LinkedIn" (desktop, phone and web; docs/LINKEDIN-SIGNIN.md). ONE LinkedIn app with the product
# "Sign In with LinkedIn using OpenID Connect" and the redirect URL PUBLIC_BASE_URL + /auth/callback/linkedin.
# Typed into config/.env by the owner on the server, re-read without a restart. Never commit them. Without both,
# no app shows the LinkedIn button.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# Optional: LINKEDIN_PKCE=off stops sending PKCE to LinkedIn (on by default; see the doc).
# LINKEDIN_PKCE=off

# The phone app and the web app have no tenant id in their calls: they sign in to this tenant. Optional when the
# server has exactly one active tenant (it is then used).
# ACCOUNT_TENANT_ID=""

# The web app's origins (comma list, https, no path). Its sign-in returns to <origin>/auth/callback and only these
# origins get CORS on /v1/web/auth/* and /v1/account/*. Empty = the web sign-in is off.
WEB_APP_ORIGINS=""

# How many phones one account may have signed in at once (1 to 100, default 3).
# MOBILE_PHONES_ALLOWED=3

# Ed25519 private key (PKCS#8 DER, base64, one line) that signs the phone relay's entitlement tokens
# (POST /v1/mobile/entitlement). Empty = that endpoint answers 503. Generate the pair with:
#   node -e "const k=require('crypto').generateKeyPairSync('ed25519');console.log('RELAY_ENTITLEMENT_SIGNING_KEY='+k.privateKey.export({format:'der',type:'pkcs8'}).toString('base64'));console.log('RELAY_ENTITLEMENT_PUBKEY='+k.publicKey.export({format:'jwk'}).x)"
# The first line goes here; the second line is the relay's RELAY_ENTITLEMENT_PUBKEY (public, not secret).
RELAY_ENTITLEMENT_SIGNING_KEY=""

# Optional: per-IP limit per minute for the signed-in account API (/v1/account/me, sessions, ...).
# ACCOUNT_API_RATE_PER_MIN=120
