# --- SoftGlaze Licensing Server — environment ---
# Copy to .env and fill in. NEVER commit .env.

# MySQL connection string (Prisma datasource). Production runs on MySQL (the
# Hostinger deploy has no Postgres), so the schema's provider is `mysql`.
DATABASE_URL="mysql://user:pass@localhost:3306/softglaze_licensing"

# 32-byte base64 master key. Encrypts tenant payment secrets AND tenant private
# keys at rest (AES-256-GCM). Losing/rotating this invalidates all sealed values.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=""

# HTTP
PORT=8787
# The public origin the desktop apps + payment webhooks reach this server at.
PUBLIC_BASE_URL="http://localhost:8787"

# License lease lifetime in days. The desktop app refreshes within this window
# while online; offline it runs on the cached lease until it expires, then nags.
LEASE_DAYS=7

# Outgoing email (verification codes, trial emails). On the live server these are written into
# config/.env by the owner's `run.sh set-smtp` (hidden prompt) and re-read without a restart.
# Leave them empty on test machines: nothing is sent and verify/start answers 503 email_unavailable.
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Proxies in front of the app (Express "trust proxy" hop count; re-read without a restart).
# 1 = the rightmost X-Forwarded-For entry. Measure it with `run.sh check-ip`.
TRUST_PROXY_HOPS=1

# Optional: domains accepted at sign-up even though they are on the disposable list (comma list).
EMAIL_DOMAIN_ALLOWLIST=""

# Optional: per-IP limits per minute (public endpoints / verification + trial endpoints).
# PUBLIC_RATE_PER_MIN=120
# VERIFY_RATE_PER_MIN=20
